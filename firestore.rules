rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure any platform database document (e.g. database, database_v2)
    match /platform/{docId} {
      allow read: if true;
      allow create: if request.resource.data.get('users', []) is list;
      allow update: if request.resource.data.get('users', []) is list
                    && request.resource.data.get('users', []).size() >= resource.data.get('users', []).size()
                    && request.resource.data.get('deposits', []).size() >= resource.data.get('deposits', []).size()
                    && request.resource.data.get('withdrawals', []).size() >= resource.data.get('withdrawals', []).size()
                    && request.resource.data.get('contracts', []).size() >= resource.data.get('contracts', []).size()
                    && request.resource.data.get('tickets', []).size() >= resource.data.get('tickets', []).size();
      allow delete: if false;
    }
    
    // Block all other collections/documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
